rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Only the authenticated server APIs can publish or delete games. In particular,
    // a client cannot replace the username or forge a Storage cleanup prefix.
    match /games/{gameId} {
      allow read: if true;
      allow write: if false;
    }

    match /users/{userId} {
      allow get: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['username'])
        && isAllowedUsername(request.resource.data.username)
        && getAfter(/databases/$(database)/documents/usernames/$(request.resource.data.username)).data.uid == userId;
    }

    match /usernames/{username} {
      // The browser needs single-name availability checks, never a directory of accounts.
      allow get: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && isAllowedUsername(username)
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.username == username;
    }

    // Keep this list synchronized with lib/reservedUsernames.json (checked by tests).
    function isAllowedUsername(username) {
      return username is string
        && username.matches('^[a-z0-9-][a-z0-9._-]{1,13}[a-z0-9-]$')
        && !username.matches('.*[_.]{2}.*')
        && !(username in [
          '404', '_next', 'about', 'api', 'browse', 'card-game-simulator.png',
          'cardback.png', 'cgs.png', 'cli', 'contact', 'developers', 'downloads',
          'favicon.ico', 'google.png', 'icon-192x192.png', 'icon-256x256.png',
          'icon-384x384.png', 'icon-512x512.png', 'llms.txt', 'manifest.json',
          'opengraph-image.alt.txt', 'opengraph-image.png', 'openapi.json',
          'privacy', 'robots.txt', 'sitemap.xml', 'sw.js', 'terms', 'upload'
        ]);
    }

    // Caches, internal data, and all nested/unknown collections are server-only.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
