    "/api/gatcg_spoilers": {
      "get": {
        "operationId": "getGrandArchiveSpoilers",
        "summary": "Read cached Grand Archive spoiler card data",
        "description": "Normally reads the assembled cache. Rate limited to 10 requests per minute per client IP per running instance. Operators may use warm=1 with the separate GATCG_WARM_TOKEN Bearer secret in production; a Firebase ID token does not grant this access. Unauthorized nocache=1 is ignored. warm runs can take up to 240 seconds and are not rate limited.",
        "parameters": [
          {
            "name": "warm",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["1"]
            },
            "description": "Operator-only cache rebuild; requires the warmToken security scheme in production."
          },
          {
            "name": "refresh",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["1"]
            },
            "description": "Re-run OCR from scratch. Only applies with warm=1."
          },
          {
            "name": "nocache",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": ["1"]
            },
            "description": "Operator-only assembled cache bypass, preserving the OCR cache. Ignored without operator authorization."
          }
        ],
        "security": [
          {},
          {
            "warmToken": []
          }
        ],
        "responses": {
          "200": {
            "description": "Spoiler cards in a data array. Pending OCR may leave effect_raw empty.",
            "headers": {
              "X-Cache": {
                "schema": {
                  "type": "string",
                  "enum": ["hit", "miss", "warm", "stale"]
                },
                "description": "Cache result."
              },
              "X-Ocr-Pending": {
                "schema": {
                  "type": "integer",
                  "minimum": 0
                },
                "description": "Cards awaiting OCR."
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["data"],
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/SpoilerCard"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Structured error. See code, message, and hint for recovery.",
            "content": {
