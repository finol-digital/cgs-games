  "components": {
    "securitySchemes": {
      "firebaseIdToken": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Firebase Auth ID token from the signed-in user. Requires a creator username."
      },
      "warmToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Operator GATCG_WARM_TOKEN secret. Only for spoiler cache maintenance; never a Firebase ID token."
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "required": ["error", "code", "message", "hint"],
        "properties": {
          "error": {
            "type": "string",
            "description": "Legacy error message retained for existing clients."
          },
          "code": {
            "type": "string",
            "example": "NOT_FOUND"
          },
          "message": {
            "type": "string"
          },
          "hint": {
            "type": "string"
          }
        }
      },
      "PublishedGame": {
        "type": "object",
        "required": ["success", "slug"],
        "properties": {
          "success": {
            "const": true
          },
          "slug": {
            "type": "string"
          }
        }
      },
      "Game": {
        "type": "object",
        "required": [
          "id",
          "username",
          "slug",
          "name",
          "bannerImageUrl",
          "autoUpdateUrl",
          "copyright",
          "uploadedAt"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "username": {
            "type": "string"
          },
          "slug": {
            "type": "string",
            "description": "URL slug. Public game pages are /{username}/{slug}."
          },
          "name": {
            "type": "string"
          },
          "bannerImageUrl": {
            "type": "string",
            "description": "HTTPS banner URL or site-relative fallback image path."
          },
          "autoUpdateUrl": {
            "type": "string",
            "format": "uri"
          },
          "copyright": {
            "type": "string"
          },
          "uploadedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SpoilerCard": {
        "type": "object",
        "required": [
          "uuid",
          "name",
          "card_image_url",
          "back_card_name",
          "back_card_image_url",
          "types",
          "element",
          "effect_raw"
        ],
        "properties": {
