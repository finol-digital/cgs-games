    "/api/games/upload": {
      "post": {
        "operationId": "uploadGame",
        "summary": "Publish a .cgs.zip archive (maximum 100 MiB)",
        "description": "Send a multipart file directly, or first upload the archive to Firebase Storage using an authenticated client and then submit its staged path. A staged archive is cleaned up after processing is attempted. Archives need a valid cgs.json and supported game assets.",
        "security": [
          {
            "firebaseIdToken": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "required": ["file"],
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary",
                    "description": ".cgs.zip archive, at most 104857600 bytes."
                  }
                }
              }
            },
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["stagedPath", "originalFilename"],
                "properties": {
                  "stagedPath": {
                    "type": "string",
                    "pattern": "^staged-uploads/[^/]+/[A-Za-z0-9_-]+\\.cgs\\.zip$",
                    "description": "staged-uploads/{authenticated Firebase uid}/{unique-id}.cgs.zip"
                  },
                  "originalFilename": {
                    "type": "string",
                    "pattern": "\\.cgs\\.zip$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Game published successfully.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PublishedGame"
                }
              }
            }
          },
          "400": {
